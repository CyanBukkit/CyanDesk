# ============================================
# CyanDesk / CrossDesk Signal Server - .env
# ============================================
# Copy this file to .env and fill in values.
#
# AUTH CHAIN (order of priority):
#   1. If CA_CERT_FILE is set (mTLS)  → client must present a cert signed
#                                      by this CA → server_password NOT needed
#   2. If CA_CERT_FILE is NOT set      → SERVER_PASSWORD required
#   3. If neither is set               → NO AUTH (not recommended!)
# ============================================

# ---- Ports ----
SIGNAL_SERVER_PORT=9090         # WebSocket (ws:// or wss://)
HTTP_API_PORT=9091              # REST JSON API for device list (GET /api/devices)

# ---- Authentication ----
# Required unless mTLS is used. Client sends this in WebSocket "login" message.
SERVER_PASSWORD=changeme_please

# ---- TLS (optional but strongly recommended) ----
# Both files must be set to enable TLS WebSocket (wss://).
# Generate with `docker/generate_certs.sh` or openssl.
SSL_CERT_FILE=./certs/server_cert.pem       # fullchain (server cert + CA)
SSL_KEY_FILE=./certs/server_key.pem         # private key

# ---- mTLS (optional) ----
# If set, client must present a certificate signed by this CA.
# When mTLS authenticates a client, SERVER_PASSWORD is NOT required.
# Leave empty to disable mTLS.
CA_CERT_FILE=./certs/ca_root.pem            # empty = no client cert required
